{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deck.schema.json",
  "title": "牌组（decks/<名>.yaml）",
  "type": "object",
  "required": [
    "id",
    "name",
    "cards"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "card",
          "suit",
          "rank"
        ],
        "properties": {
          "card": {
            "type": "string"
          },
          "suit": {
            "enum": [
              "S",
              "H",
              "C",
              "D"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}