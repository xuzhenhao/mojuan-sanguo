{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "奇遇事件（一事件一文件：events/ch<N>/<ID>-<名>.yaml，docs/specs/events-v05.md）",
  "type": "object",
  "required": ["id", "title", "art", "desc", "chapters", "enabled", "options"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^V\\d{2}$" },
    "title": { "type": "string" },
    "art": { "type": "string" },
    "desc": { "type": "string" },
    "chapters": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 3 } },
    "enabled": { "type": "boolean" },
    "options": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/option" } }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["text", "outcomes"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "hint": { "type": "string", "description": "选项下方的一行说明（可选）" },
        "result": { "type": "string", "description": "结果页文案（可选；判定 / 概率选项可用 resultSuccess / resultFail）" },
        "resultSuccess": { "type": "string" },
        "resultFail": { "type": "string" },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/require" } },
        "outcomes": { "$ref": "#/$defs/outcomes" }
      }
    },
    "require": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["gold_at_least", "max_hp_at_least", "hero_is", "deck_removable", "hp_below_max"] },
        "value": { "type": "integer" },
        "hero": { "type": "string" }
      }
    },
    "outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } },
    "outcome": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["gold", "heal", "damage", "max_hp", "add_card", "remove_card", "roll", "judge", "next_battle_buff", "battle", "branch", "leave"] },
        "value": { "oneOf": [{ "type": "integer" }, { "const": "full" }] },
        "card": { "type": "string" },
        "pool": {
          "type": "object",
          "properties": { "rarity": { "enum": ["N", "R", "E", "L"] }, "hero": { "type": "string" } },
          "additionalProperties": false
        },
        "count": { "type": "integer", "minimum": 1 },
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "success": { "$ref": "#/$defs/outcomes" },
        "fail": { "$ref": "#/$defs/outcomes" },
        "red": { "$ref": "#/$defs/outcomes" },
        "black": { "$ref": "#/$defs/outcomes" },
        "armor": { "type": "integer", "minimum": 1 },
        "difficulty": { "enum": ["easy"] },
        "reward_mult": { "type": "object", "properties": { "gold": { "type": "number", "minimum": 1 } }, "additionalProperties": false },
        "if": { "$ref": "#/$defs/require" },
        "then": { "$ref": "#/$defs/outcomes" },
        "else": { "$ref": "#/$defs/outcomes" }
      }
    }
  }
}
