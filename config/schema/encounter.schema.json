{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "encounter.schema.json",
  "title": "战斗组包（一章一个文件：encounters/<章>.yaml）",
  "type": "object",
  "required": [
    "chapter",
    "battles"
  ],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "battles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "enemies"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "普通",
              "精英",
              "Boss"
            ]
          },
          "enemies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "weight": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "pools": {
      "type": "object",
      "description": "战斗组包（PRD 10.5）：池内随机等权，同池不连续抽到同一组合",
      "required": [
        "easy",
        "normal",
        "elite",
        "boss"
      ],
      "additionalProperties": false,
      "properties": {
        "easy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "enemies"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "enemies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 3
              }
            }
          }
        },
        "normal": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "enemies"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "enemies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 3
              }
            }
          }
        },
        "elite": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "enemies"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "enemies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 3
              }
            }
          }
        },
        "boss": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "enemies"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "enemies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "maxItems": 3
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "easyBattles",
        "noRepeatInPool"
      ],
      "properties": {
        "easyBattles": {
          "type": "integer",
          "minimum": 0,
          "description": "本章前 N 场普通战斗用 easy 池"
        },
        "noRepeatInPool": {
          "type": "boolean",
          "description": "同一池内不连续抽到同一组合"
        }
      }
    }
  },
  "additionalProperties": false
}