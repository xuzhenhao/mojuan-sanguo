{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "encounter.schema.json",
  "title": "战斗组包（一章一个文件：encounters/<章>.yaml）",
  "type": "object",
  "required": [
    "chapter",
    "battles"
  ],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "battles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "enemies"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "普通",
              "精英",
              "Boss"
            ]
          },
          "enemies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "weight": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}