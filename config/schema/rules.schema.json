{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "全局规则（config/rules.yaml）",
  "type": "object",
  "required": [
    "lingPerTurn",
    "drawPerTurn",
    "firstTurnBonus",
    "minHandLimit",
    "responseSeconds",
    "armorKeep",
    "maxFlashMarks",
    "starterDeck",
    "enemyCards",
    "epiphany",
    "rarityWeight",
    "checks",
    "mechanics"
  ],
  "properties": {
    "lingPerTurn": {
      "type": "integer",
      "minimum": 0,
      "description": "每回合军令"
    },
    "drawPerTurn": {
      "type": "integer",
      "minimum": 0,
      "description": "每回合摸牌"
    },
    "firstTurnBonus": {
      "type": "integer",
      "minimum": 0,
      "description": "首回合额外摸牌"
    },
    "minHandLimit": {
      "type": "integer",
      "minimum": 0,
      "description": "手牌上限 = max(本值, 当前体力)"
    },
    "responseSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "响应窗口秒数"
    },
    "armorKeep": {
      "type": "integer",
      "minimum": 0,
      "description": "玩家回合开始时护甲最多保留几点"
    },
    "enemyArmorKeep": {
      "type": "integer",
      "minimum": 0,
      "description": "敌人从第 2 回合起，回合开始（被动技结算前）护甲最多保留几点（design-v1 8.1）"
    },
    "maxFlashMarks": {
      "type": "integer",
      "minimum": 0,
      "description": "敌人闪标记上限"
    },
    "starterDeck": {
      "type": "string",
      "description": "开局牌组（decks/ 下的 id）"
    },
    "enemyCards": {
      "type": "object",
      "description": "敌人意图牌定义：t=类型，dmg=伤害，mod=显示的进化词条名",
      "additionalProperties": {
        "type": "object",
        "required": [
          "t"
        ],
        "properties": {
          "t": {
            "enum": [
              "杀",
              "万箭",
              "闪",
              "咒"
            ]
          },
          "dmg": {
            "type": "integer",
            "minimum": 0
          },
          "mod": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "epiphany": {
      "type": "object",
      "required": [
        "baseRate",
        "maxPerBattle",
        "pityPlays"
      ],
      "properties": {
        "baseRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "灵光一闪基础概率"
        },
        "maxPerBattle": {
          "type": "integer",
          "minimum": 0
        },
        "pityPlays": {
          "type": "integer",
          "minimum": 0,
          "description": "保底：连续多少张未触发后必触发"
        }
      },
      "additionalProperties": false
    },
    "rarityWeight": {
      "type": "object",
      "required": [
        "N",
        "R",
        "E",
        "L"
      ],
      "description": "词条稀有度权重",
      "properties": {
        "N": {
          "type": "integer",
          "minimum": 0
        },
        "R": {
          "type": "integer",
          "minimum": 0
        },
        "E": {
          "type": "integer",
          "minimum": 0
        },
        "L": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "pendingValues": {
      "type": "object",
      "description": "尚未实装的卡牌数值登记（实装后移入对应卡牌文件）",
      "additionalProperties": {
        "type": "number"
      }
    },
    "checks": {
      "type": "object",
      "description": "业务校验开关（第③步套 V1 数值时开启）",
      "properties": {
        "starterRedRatio": {
          "type": [
            "number",
            "null"
          ],
          "description": "起始牌组红色比例必须等于该值；null 不检查"
        },
        "zeroCostDrawNeedsLimit": {
          "type": "boolean",
          "description": "0 费且会摸牌的牌必须带 limit"
        },
        "comboStartArmorMax": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "mechanics": {
      "type": "object",
      "description": "机制开关（默认保持现行行为）",
      "required": [
        "judgeSource",
        "passiveQuotaPerEnemyTurn",
        "moying",
        "zeroCostPerTurn"
      ],
      "properties": {
        "judgeSource": {
          "enum": [
            "deck",
            "pool"
          ],
          "description": "判定来源：deck=玩家摸牌堆；pool=独立天机签筒（52 张标准花色）"
        },
        "passiveQuotaPerEnemyTurn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "被动免伤配额，null=不限"
        },
        "moying": {
          "type": "boolean",
          "description": "墨影：精英/Boss 在玩家满血时多出 1 张杀"
        },
        "zeroCostPerTurn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "0 费非响应牌每回合每种限次，null=不限"
        }
      },
      "additionalProperties": false
    },
    "presets": {
      "type": "object",
      "description": "自动对局 / 回归用的预设（不影响正式选将）",
      "additionalProperties": {
        "type": "object",
        "required": [
          "main",
          "sub"
        ],
        "properties": {
          "main": {
            "type": "string"
          },
          "sub": {
            "type": "string"
          },
          "deck": {
            "type": "string",
            "description": "覆盖起始牌组（decks/ 下的 id）"
          },
          "forceCombos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "强制启用的珠联（按名称，即使 enabled: false）"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "defaultHeroes": {
      "type": "object",
      "required": [
        "main",
        "sub"
      ],
      "properties": {
        "main": {
          "type": "string"
        },
        "sub": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "未指定选将时的默认主将 / 副将"
    },
    "betweenBattleHeal": {
      "type": "integer",
      "minimum": 0,
      "description": "自动对局整章模拟：战间回复体力（验收口径：1）"
    }
  },
  "additionalProperties": false
}