{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "全局规则（config/rules.yaml）",
  "type": "object",
  "required": [
    "lingPerTurn",
    "drawPerTurn",
    "firstTurnBonus",
    "minHandLimit",
    "handHardCap",
    "responseSeconds",
    "armorKeep",
    "maxFlashMarks",
    "starterDeck",
    "enemyCards",
    "epiphany",
    "rarityWeight",
    "checks",
    "mechanics",
    "sim",
    "map",
    "revive",
    "economy",
    "event",
    "settlement",
    "settings",
    "assets",
    "battleTitle",
    "fonts"
  ],
  "properties": {
    "lingPerTurn": {
      "type": "integer",
      "minimum": 0,
      "description": "每回合军令"
    },
    "drawPerTurn": {
      "type": "integer",
      "minimum": 0,
      "description": "每回合摸牌"
    },
    "firstTurnBonus": {
      "type": "integer",
      "minimum": 0,
      "description": "首回合额外摸牌"
    },
    "handHardCap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "description": "手牌硬上限（PRD §5.4 = 10）：超出时新摸到的牌直接进弃牌堆，不触发弃置类效果"
    },
    "minHandLimit": {
      "type": "integer",
      "minimum": 0,
      "description": "手牌上限 = max(本值, 当前体力)"
    },
    "responseSeconds": {
      "type": "integer",
      "minimum": 0,
      "description": "响应窗口秒数"
    },
    "armorKeep": {
      "type": "integer",
      "minimum": 0,
      "description": "玩家回合开始时护甲最多保留几点"
    },
    "enemyArmorKeep": {
      "type": "integer",
      "minimum": 0,
      "description": "敌人从第 2 回合起，回合开始（被动技结算前）护甲最多保留几点（design-v1 8.1）"
    },
    "maxFlashMarks": {
      "type": "integer",
      "minimum": 0,
      "description": "敌人闪标记上限"
    },
    "starterDeck": {
      "type": "string",
      "description": "开局牌组（decks/ 下的 id）"
    },
    "enemyCards": {
      "type": "object",
      "description": "敌人意图牌定义：t=类型，dmg=伤害，mod=显示的进化词条名",
      "additionalProperties": {
        "type": "object",
        "required": [
          "t"
        ],
        "properties": {
          "t": {
            "enum": [
              "杀",
              "万箭",
              "闪",
              "咒"
            ]
          },
          "dmg": {
            "type": "integer",
            "minimum": 0
          },
          "mod": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "epiphany": {
      "type": "object",
      "required": [
        "baseRate",
        "maxPerBattle",
        "pityPlays"
      ],
      "properties": {
        "baseRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "灵光一闪基础概率"
        },
        "maxPerBattle": {
          "type": "integer",
          "minimum": 0
        },
        "pityPlays": {
          "type": "integer",
          "minimum": 0,
          "description": "保底：连续多少张未触发后必触发"
        }
      },
      "additionalProperties": false
    },
    "rarityWeight": {
      "type": "object",
      "required": [
        "N",
        "R",
        "E",
        "L"
      ],
      "description": "词条稀有度权重",
      "properties": {
        "N": {
          "type": "integer",
          "minimum": 0
        },
        "R": {
          "type": "integer",
          "minimum": 0
        },
        "E": {
          "type": "integer",
          "minimum": 0
        },
        "L": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "pendingValues": {
      "type": "object",
      "description": "尚未实装的卡牌数值登记（实装后移入对应卡牌文件）",
      "additionalProperties": {
        "type": "number"
      }
    },
    "checks": {
      "type": "object",
      "description": "业务校验开关（第③步套 V1 数值时开启）",
      "properties": {
        "starterRedRatio": {
          "type": [
            "number",
            "null"
          ],
          "description": "起始牌组红色比例必须等于该值；null 不检查"
        },
        "zeroCostDrawNeedsLimit": {
          "type": "boolean",
          "description": "0 费且会摸牌的牌必须带 limit"
        },
        "comboStartArmorMax": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "mechanics": {
      "type": "object",
      "description": "机制开关（默认保持现行行为）",
      "required": [
        "judgeSource",
        "passiveQuotaPerEnemyTurn",
        "moying",
        "zeroCostPerTurn"
      ],
      "properties": {
        "judgeSource": {
          "enum": [
            "deck",
            "pool"
          ],
          "description": "判定来源：deck=玩家摸牌堆；pool=独立天机签筒（52 张标准花色）"
        },
        "passiveQuotaPerEnemyTurn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "被动免伤配额，null=不限"
        },
        "moying": {
          "type": "boolean",
          "description": "墨影：精英/Boss 在玩家满血时多出 1 张杀"
        },
        "zeroCostPerTurn": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "0 费非响应牌每回合每种限次，null=不限"
        }
      },
      "additionalProperties": false
    },
    "presets": {
      "type": "object",
      "description": "自动对局 / 回归用的预设（不影响正式选将）",
      "additionalProperties": {
        "type": "object",
        "required": [
          "main",
          "sub"
        ],
        "properties": {
          "main": {
            "type": "string"
          },
          "sub": {
            "type": "string"
          },
          "deck": {
            "type": "string",
            "description": "覆盖起始牌组（decks/ 下的 id）"
          },
          "forceCombos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "强制启用的珠联（按名称，即使 enabled: false）"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "defaultHeroes": {
      "type": "object",
      "required": [
        "main",
        "sub"
      ],
      "properties": {
        "main": {
          "type": "string"
        },
        "sub": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "未指定选将时的默认主将 / 副将"
    },
    "shop": {
      "type": "object",
      "description": "商店（PRD 14.2）",
      "required": [
        "cardPrice",
        "relicPrice",
        "removeBase",
        "removeStep",
        "shopSlots"
      ],
      "properties": {
        "cardPrice": {
          "type": "object",
          "description": "卡牌按稀有度的基础价（浮动前）；卡牌可用 shopPrice 单独覆盖",
          "required": [
            "N",
            "R",
            "E",
            "L"
          ],
          "properties": {
            "N": {
              "type": "integer",
              "minimum": 0,
              "multipleOf": 5
            },
            "R": {
              "type": "integer",
              "minimum": 0,
              "multipleOf": 5
            },
            "E": {
              "type": "integer",
              "minimum": 0,
              "multipleOf": 5
            },
            "L": {
              "type": "integer",
              "minimum": 0,
              "multipleOf": 5
            }
          },
          "additionalProperties": false
        },
        "relicPrice": {
          "type": "object",
          "description": "宝物按稀有度的基础价（浮动前）",
          "required": [
            "N",
            "R",
            "E"
          ],
          "properties": {
            "N": {
              "type": "integer",
              "minimum": 0,
              "multipleOf": 5
            },
            "R": {
              "type": "integer",
              "minimum": 0,
              "multipleOf": 5
            },
            "E": {
              "type": "integer",
              "minimum": 0,
              "multipleOf": 5
            }
          },
          "additionalProperties": false
        },
        "removeBase": {
          "type": "integer",
          "minimum": 0,
          "description": "删牌首次价格"
        },
        "removeStep": {
          "type": "integer",
          "minimum": 0,
          "description": "每次删牌后的涨价"
        },
        "shopSlots": {
          "type": "object",
          "description": "集市各类槽位数",
          "required": [
            "common",
            "heroCard",
            "relic",
            "potion"
          ],
          "properties": {
            "common": {
              "type": "integer",
              "minimum": 0
            },
            "heroCard": {
              "type": "integer",
              "minimum": 0
            },
            "relic": {
              "type": "integer",
              "minimum": 0
            },
            "potion": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sim": {
      "type": "object",
      "required": [
        "baselineBetweenBattleHeal",
        "shan",
        "reward"
      ],
      "additionalProperties": false,
      "description": "自动对局 / 回归基线专用参数",
      "properties": {
        "baselineBetweenBattleHeal": {
          "type": "integer",
          "minimum": 0,
          "description": "3 战回归基线：战间回复体力（design-v1 §12.2：1）"
        },
        "shan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "keepMax",
            "takeHitHpRatio"
          ],
          "description": "#241 AI 留闪策略（sim 专用）",
          "properties": {
            "mode": {
              "enum": [
                "legacy",
                "budget"
              ]
            },
            "keepMax": {
              "type": "integer",
              "minimum": 0
            },
            "takeHitHpRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "reward": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skipBelow",
            "loopMaxInDeck",
            "shopBuyMinGold",
            "shopMaxCards"
          ],
          "description": "#241 模拟卡牌奖励 / 商店选牌 AI（sim 专用）",
          "properties": {
            "skipBelow": {
              "type": "number"
            },
            "loopMaxInDeck": {
              "type": "integer",
              "minimum": 0
            },
            "shopBuyMinGold": {
              "type": "integer",
              "minimum": 0
            },
            "shopMaxCards": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "map": {
      "type": "object",
      "description": "章节地图与正式地图流程参数（PRD 10.1–10.4、10.9；betweenBattleHeal 来自 #77）",
      "additionalProperties": false,
      "required": [
        "layers",
        "columns",
        "paths",
        "distinctStarts",
        "fixedLayers",
        "weights",
        "constraints",
        "boss",
        "nodeIcons",
        "betweenBattleHeal",
        "rest"
      ],
      "properties": {
        "layers": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "columns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 7
        },
        "paths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "distinctStarts": {
          "type": "integer",
          "minimum": 1
        },
        "fixedLayers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "enum": [
              "BATTLE",
              "ELITE",
              "EVENT",
              "REST",
              "SHOP",
              "CHEST"
            ]
          }
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "layers",
              "BATTLE",
              "ELITE",
              "EVENT",
              "REST",
              "SHOP",
              "CHEST"
            ],
            "additionalProperties": false,
            "properties": {
              "layers": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "[起层, 止层]（含）"
              },
              "BATTLE": {
                "type": "integer",
                "minimum": 0
              },
              "ELITE": {
                "type": "integer",
                "minimum": 0
              },
              "EVENT": {
                "type": "integer",
                "minimum": 0
              },
              "REST": {
                "type": "integer",
                "minimum": 0
              },
              "SHOP": {
                "type": "integer",
                "minimum": 0
              },
              "CHEST": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minLayerFor",
            "noConsecutive",
            "distinctSiblings",
            "minElite",
            "shopOnEveryStart",
            "maxRerolls"
          ],
          "properties": {
            "minLayerFor": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "BATTLE",
                  "ELITE",
                  "EVENT",
                  "REST",
                  "SHOP",
                  "CHEST"
                ]
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "noConsecutive": {
              "type": "array",
              "items": {
                "enum": [
                  "BATTLE",
                  "ELITE",
                  "EVENT",
                  "REST",
                  "SHOP",
                  "CHEST"
                ]
              },
              "uniqueItems": true
            },
            "distinctSiblings": {
              "type": "boolean"
            },
            "minElite": {
              "type": "integer",
              "minimum": 0
            },
            "shopOnEveryStart": {
              "type": "boolean"
            },
            "maxRerolls": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "boss": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "章 → Boss 敌人 id"
        },
        "layerSpacing": {
          "type": "number",
          "minimum": 30
        },
        "moveMs": {
          "type": "integer",
          "minimum": 0
        },
        "bossConfirm": {
          "type": "object",
          "description": "首领确认弹层布局与动效（#188 / spec-107 A）",
          "additionalProperties": false,
          "required": [
            "panel",
            "card",
            "status",
            "button",
            "scrimAlpha",
            "popInMs",
            "fadeOutMs",
            "glowPeriodMs"
          ],
          "properties": {
            "panel": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "w",
                "top",
                "minTop",
                "padTop",
                "padBottom"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "top": {
                  "type": "number",
                  "minimum": 0
                },
                "minTop": {
                  "type": "number",
                  "minimum": 0
                },
                "padTop": {
                  "type": "number",
                  "minimum": 0
                },
                "padBottom": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "card": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "w",
                "h",
                "gap"
              ],
              "properties": {
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                },
                "gap": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "status": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "w",
                "h",
                "gap"
              ],
              "properties": {
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                },
                "gap": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "button": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "w",
                "h",
                "gap"
              ],
              "properties": {
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                },
                "gap": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "scrimAlpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "popInMs": {
              "type": "number",
              "minimum": 0
            },
            "fadeOutMs": {
              "type": "number",
              "minimum": 0
            },
            "glowPeriodMs": {
              "type": "number",
              "minimum": 1
            }
          }
        },
        "pulseMs": {
          "type": "integer",
          "minimum": 100
        },
        "nodeIcons": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "BATTLE",
              "ELITE",
              "EVENT",
              "REST",
              "SHOP",
              "CHEST",
              "BOSS"
            ]
          },
          "additionalProperties": {
            "$ref": "icon.schema.json"
          }
        },
        "betweenBattleHeal": {
          "type": "integer",
          "minimum": 0,
          "description": "正式地图战间回复体力（PRD 0.5.4 §10.4：H5 为 0）"
        },
        "rest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "healMin",
            "healRatio"
          ],
          "description": "营地疗伤（PRD 10.6）：回复 max(healMin, floor(最大体力 × healRatio))",
          "properties": {
            "healMin": {
              "type": "integer",
              "minimum": 0
            },
            "healRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "chapters"
      ],
      "additionalProperties": false,
      "properties": {
        "chapters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "开放章节数（PRD 10.1 run.chapters）"
        }
      }
    },
    "maxEnemiesAlive": {
      "type": "integer",
      "minimum": 1,
      "description": "场上同时存活敌人上限（召唤受此约束，达到上限时召唤落空；PRD 未写，取最保守 = 组包最大人数 3）"
    },
    "revive": {
      "type": "object",
      "description": "复活（PRD §4.4.1；仅天命<5）",
      "required": [
        "count",
        "hpRatio",
        "hpMin",
        "armor"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "每局复活次数"
        },
        "hpRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "复活体力占上限比例（向上取整）"
        },
        "hpMin": {
          "type": "integer",
          "minimum": 1,
          "description": "复活体力下限"
        },
        "armor": {
          "type": "integer",
          "minimum": 0,
          "description": "复活附带护甲"
        }
      }
    },
    "economy": {
      "type": "object",
      "description": "局内经济（#172）",
      "required": [
        "startGold",
        "potionSlots",
        "battleGold",
        "cardRarity",
        "eliteHighMul",
        "factionMul",
        "potionDrop",
        "relicRarity",
        "bossRelicPool",
        "bossRelicFill",
        "priceJitter",
        "priceRound",
        "shopRefresh",
        "shopFreeRefresh",
        "minDeck",
        "chestRelicChance",
        "chestGold",
        "chestRelicRarity",
        "destinyShopMarkup"
      ],
      "additionalProperties": false,
      "properties": {
        "startGold": {
          "type": "integer",
          "minimum": 0,
          "description": "14.1 开局铜钱"
        },
        "potionSlots": {
          "type": "integer",
          "minimum": 0,
          "description": "12.2 丹药栏"
        },
        "battleGold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normal",
            "elite",
            "boss"
          ],
          "description": "14.1 战斗铜钱 [min,max]，按章 1–3",
          "properties": {
            "normal": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "description": "normal"
            },
            "elite": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "description": "elite"
            },
            "boss": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
