{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relic.schema.json",
  "title": "宝物（一件一文件：relics/<ID>.yaml，PRD 12.1；#173）",
  "type": "object",
  "required": [
    "id",
    "name",
    "rarity",
    "desc"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^R\\d{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "rarity": {
      "enum": [
        "N",
        "R",
        "E",
        "L",
        "Boss"
      ]
    },
    "desc": {
      "type": "string",
      "minLength": 1
    },
    "oneShot": {
      "type": "boolean",
      "description": "每局限触发 1 次（触发后记入 RunState）"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "局外经济/营地的参数化效果（战斗内效果见 abilities）",
      "properties": {
        "goldBonus": {
          "type": "integer",
          "minimum": 1,
          "description": "每场战斗胜利铜钱 +N"
        },
        "eliteGoldBonus": {
          "type": "integer",
          "minimum": 1,
          "description": "精英战奖励铜钱 +N"
        },
        "shopDiscount": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "集市价格 −比例（多件相加）"
        },
        "shopPotionSlots": {
          "type": "integer",
          "minimum": 1,
          "description": "集市丹药槽 +N"
        },
        "restHeal": {
          "type": "integer",
          "minimum": 1,
          "description": "营地疗伤 +N"
        }
      }
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ability"
      },
      "description": "战斗内能力列表（#238）"
    }
  },
  "$defs": {
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on"
      ],
      "minProperties": 2,
      "description": "战斗内能力（#238/#195）：on 为触发时机，其余字段为数值，代码不按 id 判断",
      "properties": {
        "on": {
          "enum": [
            "battle_start",
            "turn_start",
            "use",
            "passive"
          ],
          "description": "battle_start=每场战斗开始；turn_start=每回合开始；use=使用时（丹药）；passive=常驻修正"
        },
        "ling": {
          "type": "integer",
          "minimum": 1,
          "description": "军令 +N（走 addLing，受产令上限）"
        },
        "handLimit": {
          "type": "integer",
          "not": {
            "const": 0
          },
          "description": "手牌上限 ±N（passive）"
        },
        "armor": {
          "type": "integer",
          "minimum": 1,
          "description": "护甲 +N（battle_start）"
        },
        "epiphanyRate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "灵光一闪基础概率 +比例（passive，多件相加）"
        }
      }
    }
  }
}
