{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hero.schema.json",
  "title": "武将配置（一名武将一个文件：heroes/<拼音>.yaml）",
  "type": "object",
  "required": [
    "id",
    "name",
    "faction",
    "hp",
    "role",
    "mainSkills",
    "subSkill",
    "starterDeck"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^H[0-9]{2}$"
    },
    "name": {
      "type": "string"
    },
    "faction": {
      "enum": [
        "蜀",
        "魏",
        "吴",
        "群"
      ]
    },
    "hp": {
      "type": "integer",
      "minimum": 5,
      "maximum": 10
    },
    "role": {
      "type": "string",
      "description": "玩法定位（展示 + 策划）"
    },
    "unlock": {
      "type": "string",
      "description": "解锁条件，如 初始 / 将魂80"
    },
    "budget": {
      "type": "object",
      "description": "价值预算：主将合计目标 22±1.5 点/场",
      "properties": {
        "hp": {
          "type": "number"
        },
        "main": {
          "type": "number"
        },
        "sub": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      }
    },
    "mainSkills": {
      "type": "array",
      "items": {
        "$ref": "effect.schema.json#/$defs/ability"
      },
      "minItems": 1,
      "maxItems": 3
    },
    "subSkill": {
      "$ref": "effect.schema.json#/$defs/ability"
    },
    "starterDeck": {
      "type": "array",
      "description": "起始牌组（必填）：card=卡牌 id，suit/rank 花色点数。roster=true 的武将红色比例需 = rules.checks.starterRedRatio",
      "items": {
        "type": "object",
        "required": [
          "card",
          "suit",
          "rank"
        ],
        "properties": {
          "card": {
            "type": "string"
          },
          "suit": {
            "enum": [
              "S",
              "H",
              "C",
              "D"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          }
        },
        "additionalProperties": false
      },
      "minItems": 10,
      "maxItems": 12
    },
    "exclusiveCards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "combos": {
      "type": "array",
      "description": "珠联璧合（本武将为主将时）",
      "items": {
        "type": "object",
        "required": [
          "partner",
          "name",
          "abilities"
        ],
        "properties": {
          "partner": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "abilities": {
            "type": "array",
            "items": {
              "$ref": "effect.schema.json#/$defs/ability"
            }
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "false = 停用（保留配置）"
          }
        },
        "additionalProperties": false
      }
    },
    "roster": {
      "type": "boolean",
      "default": true,
      "description": "是否进入开局名单 / 选将界面（false = 保留配置但不可选，如关羽 H09）"
    },
    "portrait": {
      "type": "string",
      "pattern": "^portraits/heroes/[a-z0-9_-]+\\.webp$",
      "description": "立绘（#177）：相对 rules.assets.baseUrl 的路径，如 portraits/heroes/liubei.webp（512×712）。小图档 256×356 在 .webp 前插 @s 推出（portraits/heroes/liubei@s.webp），不单独配置。缺省或加载失败时回退程序占位。"
    },
    "portraitFocus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 512
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 712
        }
      },
      "description": "立绘脸部中心，单位为 512×712 大图像素；战斗副将小卡按此把脸对到卡内 (38,32)（@2x 即 (76,64)）"
    }
  },
  "additionalProperties": false
}
