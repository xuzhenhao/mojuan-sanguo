{
  "name": "mojuan-sanguo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "npm run config:build",
    "autoplay:smoke": "tsx scripts/autoplay-smoke.ts",
    "preautoplay:smoke": "npm run config:build",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "autoplay": "tsx scripts/autoplay.ts",
    "config:check": "tsx scripts/build-config.ts --check",
    "config:build": "tsx scripts/build-config.ts",
    "predev": "npm run config:build",
    "prebuild": "npm run config:build",
    "pretest": "npm run config:build",
    "preautoplay": "npm run config:build",
    "boss-sim": "tsx scripts/boss-sim.ts",
    "preboss-sim": "npm run config:build",
    "dev:debug": "vite --mode debug --open /mojuan-sanguo/debug/debug.html",
    "build:debug": "tsc && vite build --mode debug",
    "size-check": "tsx scripts/size-check.ts",
    "viewport-check": "node scripts/viewport-check.mjs",
    "prebuild:debug": "npm run config:build",
    "build:wechat": "tsc && vite build --mode wechat && tsx scripts/build-wechat.ts",
    "prebuild:wechat": "npm run config:build",
    "atlas:build": "tsx scripts/build-ui-atlas.ts",
    "font:build": "tsx scripts/build-wenkai-subset.ts",
    "font:build:wechat": "tsx scripts/build-wenkai-subset.ts --wechat"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
